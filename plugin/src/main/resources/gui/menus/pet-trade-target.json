{
  "title": "<gold><lang:Gui.PetTradeTarget.Title></gold>",
  "rows": 6,
  "esc-supports-back": true,
  "sound-on-open":  { "key": "minecraft:block.chest.open",  "volume": 0.6 },
  "sound-on-close": { "key": "minecraft:block.chest.close", "volume": 0.5 },
  "sound-on-back":  { "key": "minecraft:item.book.page_turn", "pitch": 0.85 },
  "sections": {
    "border": {
      "type": "border",
      "thickness": 1,
      "item": { "material": "YELLOW_STAINED_GLASS_PANE", "title": " " }
    },
    "targets": {
      "type": "paginated-list",
      "region": { "col": 1, "row": 1, "width": 7, "height": 4 },
      "template": {
        "material": "PLAYER_HEAD",
        "title": "<gold><lang:Gui.PetTradeTarget.Template.Title:'<target_name>'></gold>",
        "lore": ["<yellow><lang:Gui.PetTradeTarget.Template.Lore.Click></yellow>"]
      },
      "previous-page-section": "previous-page",
      "next-page-section": "next-page"
    },
    "previous-page": {
      "type": "slot",
      "position": { "col": 0, "row": 5 },
      "item": { "material": "OAK_SIGN", "title": "<gray><lang:Gui.Page.Previous:'<target_page>'></gray>" },
      "hide-at-boundary": true
    },
    "next-page": {
      "type": "slot",
      "position": { "col": 8, "row": 5 },
      "item": { "material": "OAK_SIGN", "title": "<gray><lang:Gui.Page.Next:'<target_page>'></gray>" },
      "hide-at-boundary": true
    }
  }
}
