{
  "title": "<gold><lang:Gui.NpcStorageConfirm.Title></gold>",
  "rows": 3,
  "esc-supports-back": false,
  "sound-on-open":  { "key": "minecraft:block.note_block.bell", "volume": 0.5, "pitch": 0.9 },
  "sound-on-close": { "key": "minecraft:block.chest.close",     "volume": 0.5 },
  "sections": {
    "border": {
      "type": "border",
      "thickness": 1,
      "item": { "material": "WHITE_STAINED_GLASS_PANE", "title": " " }
    },
    "display": {
      "type": "slot",
      "position": { "col": 4, "row": 1 },
      "item": {
        "material": "BONE",
        "title": "<gold><lang:Gui.NpcStorageConfirm.Title></gold>",
        "lore": ["<gray><storage_label>: <white><pet_name></white>"]
      }
    },
    "yes": {
      "type": "slot",
      "position": { "col": 3, "row": 1 },
      "item": { "material": "LIME_WOOL", "title": "<green><lang:Gui.NpcStorageConfirm.Yes></green>" },
      "sound-on-click": { "key": "minecraft:entity.experience_orb.pickup", "volume": 1.0 }
    },
    "no": {
      "type": "slot",
      "position": { "col": 5, "row": 1 },
      "item": { "material": "RED_WOOL", "title": "<red><lang:gui.cancel></red>" },
      "sound-on-click": { "key": "minecraft:ui.button.click", "volume": 0.6, "pitch": 0.8 }
    }
  }
}
