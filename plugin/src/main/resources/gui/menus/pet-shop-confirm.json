{
  "title": "<gold><lang:Gui.PetShopConfirm.Title></gold>",
  "rows": 3,
  "esc-supports-back": true,
  "sound-on-open":  { "key": "minecraft:block.note_block.bell",  "volume": 0.5, "pitch": 1.2 },
  "sound-on-close": { "key": "minecraft:block.chest.close",      "volume": 0.5 },
  "sound-on-back":  { "key": "minecraft:item.book.page_turn",    "volume": 0.5, "pitch": 0.85 },
  "sections": {
    "border": {
      "type": "border",
      "thickness": 1,
      "item": { "material": "YELLOW_STAINED_GLASS_PANE", "title": " " }
    },
    "display": {
      "type": "slot",
      "position": { "col": 4, "row": 1 },
      "item": {
        "material": "EMERALD",
        "title": "<gold><lang:Gui.PetShop.Template.Title:'<entry_name>'></gold>",
        "lore": ["<gray><price_label>: <yellow><entry_price></yellow>"]
      }
    },
    "yes": {
      "type": "slot",
      "position": { "col": 3, "row": 1 },
      "item": { "material": "LIME_WOOL", "title": "<green><lang:Gui.PetShopConfirm.Yes></green>" },
      "sound-on-click": { "key": "minecraft:entity.experience_orb.pickup", "volume": 1.0 }
    },
    "no": {
      "type": "slot",
      "position": { "col": 5, "row": 1 },
      "item": { "material": "RED_WOOL", "title": "<red><lang:gui.cancel></red>" },
      "sound-on-click": { "key": "minecraft:ui.button.click", "volume": 0.6, "pitch": 0.8 }
    }
  }
}
